{
  "rules": {
    ".read": false,
    ".write": false,

    "roomsMeta": {
      ".read": true,
      "$roomId": {
        ".write": true,
        "title": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 120)" },
        "category": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
        "description": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 500)" },
        "hostName": { ".validate": "!newData.exists() || (newData.isString() && newData.val().length <= 60)" },
        "active": { ".validate": "!newData.exists() || newData.isBoolean()" },
        "viewerCount": { ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0)" }
      }
    },

    "rooms": {
      "$roomId": {
        "viewers": {
          ".read": true,
          ".write": true
        }
      }
    },

    "roomChat": {
      "$roomId": {
        "messages": {
          ".read": true,
          "$messageId": {
            ".write": true,
            "text": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "alias": { ".validate": "newData.isString() && newData.val().length <= 24" }
          }
        }
      }
    },

    "roomReactions": {
      "$roomId": {
        ".read": true,
        "$reactionId": {
          ".write": true,
          ".validate": "newData.hasChildren(['type', 'ts'])",
          "type": { ".validate": "newData.isString() && (newData.val() === 'heart' || newData.val() === 'spark' || newData.val() === 'ring' || newData.val() === 'wave' || newData.val() === 'question')" },
          "ts": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "roomEvents": {
      "$roomId": {
        "latest": {
          ".read": true,
          ".write": true
        }
      }
    }
  }
}
