{
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      { "source": "/emisor", "destination": "/emisor/index.html" },
      { "source": "/receptor", "destination": "/receptor/index.html" }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
